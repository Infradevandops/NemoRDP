# ===========================================
# NemoRDP Production Environment Variables
# ===========================================

# ============ DATABASE ============
DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@db:5432/nemordp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=nemordp

# ============ REDIS ============
REDIS_URL=redis://redis:6379/0

# ============ SECURITY ============
# Generate with: openssl rand -hex 32
SECRET_KEY=YOUR_SECRET_KEY_HERE_GENERATE_WITH_OPENSSL
JWT_SECRET=YOUR_JWT_SECRET_HERE_GENERATE_WITH_OPENSSL
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============ PROVIDER APIs ============
# Vultr API (for Windows RDP)
VULTR_API_KEY=YOUR_VULTR_API_KEY

# Contabo API (for Linux RDP)
CONTABO_API_KEY=YOUR_CONTABO_API_KEY
CONTABO_CLIENT_ID=YOUR_CONTABO_CLIENT_ID
CONTABO_CLIENT_SECRET=YOUR_CONTABO_CLIENT_SECRET

# ============ PAYMENT GATEWAYS ============
# Paystack (Card Payments)
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY

# Crypto Wallet Addresses (REPLACE WITH YOUR REAL ADDRESSES)
CRYPTO_BTC_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
CRYPTO_ETH_ADDRESS=0x71C7656EC7ab88b098defB751B7401B5f6d8976F
CRYPTO_USDT_ADDRESS=TVc2C1iP9A6d7F3b3b3b3b3b3b3b3b3b3b

# ============ EMAIL (SMTP) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@nemordp.com
SMTP_FROM_NAME=NemoRDP

# ============ APPLICATION ============
ENVIRONMENT=production
DEBUG=false
ALLOWED_HOSTS=api.nemordp.com,nemordp.com
CORS_ORIGINS=https://nemordp.com,https://www.nemordp.com

# ============ MONITORING ============
SENTRY_DSN=YOUR_SENTRY_DSN_HERE
