# Application
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.nemorDP.com
FRONTEND_URL=https://nemorDP.com

# Database
DATABASE_URL=postgresql://nemorDP_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/nemorDP_prod
POSTGRES_USER=nemorDP_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nemorDP_prod

# Redis
REDIS_URL=redis://redis:6379/0

# Security (Generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY
JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY

# Provider APIs
VULTR_API_KEY=your_vultr_api_key_here
CONTABO_CLIENT_ID=your_contabo_client_id_here
CONTABO_CLIENT_SECRET=your_contabo_client_secret_here

# Payment
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
EMAIL_FROM=noreply@nemorDP.com

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here

# Domain
DOMAIN=nemorDP.com
